// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql" // o mysql, sqlite, etc.
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashInOutType {
  IN
  OUT
}

enum UserRole {
  ADMIN
  CASHIER
}

enum PurchaseDocumentType {
  CREDITO_FISCAL // tipoDte 03
  NOTA_CREDITO // tipoDte 05
}

// ----------------------------------------------------
// USER & EMPLOYEE MODELS
// ----------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CASHIER)
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones de auditoría (quién abrió y quién cerró la caja)
  openings Opening[]
  closings Closing[]

  // Auditoría de compras (quién importó y quién anuló cada documento)
  importedPurchaseDocuments PurchaseDocument[] @relation("PurchaseDocumentImportedBy")
  voidedPurchaseDocuments   PurchaseDocument[] @relation("PurchaseDocumentVoidedBy")

  // Auditoría del análisis de precios (quién unió variantes o descartó sugerencias)
  productVariants             ProductVariant[]
  productSuggestionDismissals ProductSuggestionDismissal[]
}

model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con transacciones
  transactions TransactionRecord[]
}

// ----------------------------------------------------
// CASH REGISTER MODELS
// ----------------------------------------------------

model CashRegisterRecord {
  id        Int                @id @default(autoincrement())
  status    CashRegisterStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // 1-to-1 Relations
  opening Opening?
  closing Closing?

  // 1-to-N Relations
  transactions TransactionRecord[]
  cashInOut    CashInOutRecord[]

  // Solo puede existir una caja abierta a la vez (índice único parcial)
  @@unique([status], map: "CashRegisterRecord_single_open_key", where: raw("status = 'OPEN'"))
}

model Opening {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  cash          Decimal  @db.Decimal(12, 2)
  note          String?
  denominations Json? // Structure: [{ value: number, quantity: number }

  // Foreign Key for CashRegisterRecord (1-to-1)
  cashRegisterRecordId Int                @unique
  cashRegisterRecord   CashRegisterRecord @relation(fields: [cashRegisterRecordId], references: [id], onDelete: Cascade)

  // Relación con el Usuario que realiza la apertura
  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Closing {
  id                   Int      @id @default(autoincrement())
  cashRegisterRecordId Int      @unique
  cashProvided         Decimal  @db.Decimal(12, 2)
  difference           Decimal  @db.Decimal(12, 2)
  totalTransactions    Decimal  @db.Decimal(12, 2)
  totalCashInOut       Decimal  @db.Decimal(12, 2)
  totalExpected        Decimal  @db.Decimal(12, 2)
  userId               Int
  denominations        Json?
  note                 String?
  createdAt            DateTime @default(now())

  cashRegisterRecord CashRegisterRecord @relation(fields: [cashRegisterRecordId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id])
}

model CashInOutRecord {
  id     Int           @id @default(autoincrement())
  type   CashInOutType
  amount Decimal       @db.Decimal(12, 2)
  reason String
  date   DateTime      @default(now())
  note   String?

  cashRegisterRecordId Int
  cashRegisterRecord   CashRegisterRecord @relation(fields: [cashRegisterRecordId], references: [id], onDelete: Cascade)
}

model TransactionRecord {
  id             Int      @id @default(autoincrement())
  date           DateTime @default(now())
  amountToCharge Decimal  @db.Decimal(12, 2)
  cashProvided   Decimal  @db.Decimal(12, 2)
  changeReturned Decimal  @db.Decimal(12, 2)
  note           String?
  denominations  Json? // Structure: [{ value: number, quantity: number }]

  // Relación con CashRegisterRecord
  cashRegisterRecordId Int
  cashRegisterRecord   CashRegisterRecord @relation(fields: [cashRegisterRecordId], references: [id], onDelete: Cascade)

  // Relación con Employee
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
}

// ----------------------------------------------------
// PURCHASE (DTE) MODELS
// ----------------------------------------------------

// Se crea y actualiza solo a partir del emisor de los DTE importados
model Supplier {
  id                  Int      @id @default(autoincrement())
  nit                 String   @unique
  nrc                 String?
  name                String
  commercialName      String?
  activityCode        String?
  activityDescription String?
  phone               String?
  email               String?
  lastIssueDate       DateTime @db.Date // Fecha del DTE más reciente; sus datos son los que se guardan
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  documents                   PurchaseDocument[]
  productVariants             ProductVariant[]
  productSuggestionDismissals ProductSuggestionDismissal[]
}

model PurchaseDocument {
  id                 Int                  @id @default(autoincrement())
  type               PurchaseDocumentType
  generationCode     String               @unique // codigoGeneracion, en mayúsculas
  controlNumber      String
  receptionStamp     String
  schemaVersion      Int
  issueDate          DateTime             @db.Date
  issueTime          String
  currency           String               @default("USD")
  receiverNrc        String
  operationCondition Int // 1 contado, 2 crédito, 3 otro (informativo)

  nonSubjectTotal   Decimal @db.Decimal(12, 2)
  exemptTotal       Decimal @db.Decimal(12, 2)
  taxedTotal        Decimal @db.Decimal(12, 2)
  discountTotal     Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)
  ivaAmount         Decimal @db.Decimal(12, 2) // Tributo 20 (IVA 13 %)
  ivaPerceived      Decimal @db.Decimal(12, 2)
  ivaWithheld       Decimal @db.Decimal(12, 2)
  incomeTaxWithheld Decimal @db.Decimal(12, 2)
  operationTotal    Decimal @db.Decimal(12, 2) // montoTotalOperacion
  total             Decimal @db.Decimal(12, 2) // operationTotal + ivaPerceived - ivaWithheld - incomeTaxWithheld

  warnings Json? // Structure: [{ code: string, message: string }]
  rawJson  Json // DTE original completo

  voidedAt   DateTime?
  voidReason String?
  voidedById Int?

  importedById Int
  createdAt    DateTime @default(now())

  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  importedBy User     @relation("PurchaseDocumentImportedBy", fields: [importedById], references: [id])
  voidedBy   User?    @relation("PurchaseDocumentVoidedBy", fields: [voidedById], references: [id])

  items            PurchaseDocumentItem[]
  relatedDocuments CreditNoteRelation[]   @relation("CreditNote") // Si es nota de crédito: documentos que modifica
  creditNotes      CreditNoteRelation[]   @relation("RelatedDocument") // Si es crédito fiscal: notas que lo modifican

  @@index([issueDate])
  @@index([supplierId, issueDate])
}

model PurchaseDocumentItem {
  id                  Int     @id @default(autoincrement())
  itemNumber          Int
  itemType            Int
  code                String?
  description         String
  quantity            Decimal @db.Decimal(14, 4)
  unitOfMeasure       Int
  unitPrice           Decimal @db.Decimal(14, 6)
  discount            Decimal @db.Decimal(12, 2)
  nonSubjectSale      Decimal @db.Decimal(12, 2)
  exemptSale          Decimal @db.Decimal(12, 2)
  taxedSale           Decimal @db.Decimal(12, 2)
  relatedDocumentCode String? // numeroDocumento de la línea (notas de crédito)

  // Producto para el análisis de precios: se calcula al importar (ProductRefHelper)
  productRef  String?
  productName String?

  documentId Int
  document   PurchaseDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CreditNoteRelation {
  id                    Int      @id @default(autoincrement())
  relatedType           String // tipoDocumento del documento relacionado (03, ...)
  generationType        Int // 1 físico, 2 electrónico
  relatedDocumentNumber String // Código de generación (en mayúsculas) o número del documento físico
  relatedIssueDate      DateTime @db.Date

  creditNoteId      Int
  creditNote        PurchaseDocument  @relation("CreditNote", fields: [creditNoteId], references: [id], onDelete: Cascade)
  relatedDocumentId Int? // null + generationType 2 = pendiente de vincular
  relatedDocument   PurchaseDocument? @relation("RelatedDocument", fields: [relatedDocumentId], references: [id])

  @@unique([creditNoteId, relatedDocumentNumber])
  @@index([relatedDocumentNumber])
}

// ----------------------------------------------------
// ANÁLISIS DE PRECIOS DE PRODUCTOS
// ----------------------------------------------------

// Un producto de un proveedor (unidad + código) que es el mismo que otro: sus compras se suman al principal.
// Los productos no tienen tabla propia, se deducen de las líneas de los DTE (ver docs/productos-api.md)
model ProductVariant {
  id                  Int      @id @default(autoincrement())
  supplierId          Int
  unitOfMeasure       Int
  ref                 String // Código de la variante
  targetUnitOfMeasure Int
  targetRef           String // Código del producto principal (nunca es a su vez una variante)
  createdById         Int
  createdAt           DateTime @default(now())

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([supplierId, unitOfMeasure, ref])
  @@index([supplierId, targetUnitOfMeasure, targetRef])
}

// Sugerencia de variantes que el usuario marcó como "no son el mismo producto": no se vuelve a sugerir
model ProductSuggestionDismissal {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  signature   String // Nombre normalizado que agrupó la sugerencia
  createdById Int
  createdAt   DateTime @default(now())

  supplier  Supplier @relation(fields: [supplierId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@unique([supplierId, signature])
}
